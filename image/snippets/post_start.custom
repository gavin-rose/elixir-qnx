# local/snippets/post_start.custom
# Unpack the cross-compiled Erlang/OTP release and the precompiled Elixir on
# first boot, then print proof lines showing both run on QNX.
if [ ! -e /data/opt/otp/.ready ]; then
    echo "QNX-OTP: unpacking Erlang/OTP release"
    mkdir -p /data/opt/otp
    (cd /data/opt/otp && tar xzf /data/opt.tgz && ./Install -minimal /data/opt/otp)
    touch /data/opt/otp/.ready
fi
if [ ! -e /data/opt/elixir/.ready ]; then
    echo "QNX-OTP: unpacking Elixir"
    mkdir -p /data/opt/elixir
    (cd /data/opt/elixir && tar xzf /data/elixir.tgz)
    touch /data/opt/elixir/.ready
fi
if [ ! -e /data/opt/webdemo/.ready ]; then
    echo "QNX-OTP: unpacking webdemo"
    mkdir -p /data/opt/webdemo
    (cd /data/opt/webdemo && tar xzf /data/webdemo.tgz)
    touch /data/opt/webdemo/.ready
fi

export PATH=/data/opt/otp/bin:/data/opt/elixir/bin:$PATH

echo "QNX-OTP: starting erl"
erl -noshell -eval 'io:format("QNX-ERLANG-PROOF arch=~s os=~p version=~s~n",[erlang:system_info(system_architecture),os:type(),erlang:system_info(version)]), erlang:halt()'
echo "QNX-ELIXIR: starting elixir"
elixir -e 'IO.puts("QNX-ELIXIR-PROOF elixir=#{System.version()} otp=#{System.otp_release()} arch=#{List.to_string(:erlang.system_info(:system_architecture))}")'
echo "QNX-WEB: starting Bandit on :4000"
(/bin/sh /data/opt/webdemo/start.sh </dev/null >/data/var/webdemo.log 2>&1 &)
echo "QNX-DONE"
